# ==============================================================================
# ASABIYYAH TECHNOLOGIES LTD — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure these variables in the Cloudflare Pages
# project settings under Settings > Environment Variables.
# ==============================================================================

# Node / Python Build Environment
PYTHON_VERSION=3.10

# Production Canonical Domain
SITE_URL=https://www.asabiyyah.com

# Contact Intake Webhook (Optional)
# Enter a webhook URL (Slack, Discord, Zapier, or internal CRM) to receive
# real-time notifications when a user submits an inquiry on /contact.
INQUIRY_WEBHOOK_URL=https://webhook.site/placeholder-token

# Email Dispatch Configuration (Optional)
# If integrating Resend or SendGrid via Cloudflare Pages Functions:
RESEND_API_KEY=re_placeholder_token
CORPORATE_NOTIFY_EMAIL=info@asabiyyah.com
